# Copy to .env and edit. Nothing here is required: OrchestratorX runs fully
# offline on the deterministic FakeLLM unless you opt into a provider.
#
# The model is used ONLY for the report narrative. It never makes a routing or
# escalation decision, so leaving this file untouched changes prose quality and
# nothing else.

# fake (default) | claude | gemini
ORCHESTRATORX_LLM=fake

# Optional model override. Defaults: claude-opus-5 / gemini-2.0-flash
ORCHESTRATORX_MODEL=

# Only read when ORCHESTRATORX_LLM=claude. Requires: pip install ".[claude]"
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx-REPLACE-ME

# Only read when ORCHESTRATORX_LLM=gemini. Requires: pip install ".[gemini]"
GOOGLE_API_KEY=REPLACE-ME
